{
  "name": "multiplication-practice",
  "version": "1.4.2",
  "description": "A mobile-first Single Page Application for practicing multiplication exercises",
  "homepage": "https://commjoen.github.io/Multiplier/",
  "repository": {
    "type": "git",
    "url": "https://github.com/commjoen/Multiplier.git"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "scripts": {
    "test": "node test-runner.js",
    "start": "python3 -m http.server 8080",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "start-server-and-test start http://localhost:8080 cy:run",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "test:all": "npm test && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "cypress": "^16.2.0",
    "start-server-and-test": "^3.0.13"
  }
}
